# Copie este ficheiro para .env e ajuste se necessário.
PORT=3001
NODE_ENV=development

# Base de dados SQLite (já incluída; não precisa de instalar nada).
# Por defeito a base é criada em ../dados/rmvm.db (dentro da pasta do projeto).
# Só precisa de alterar se quiser guardar os dados noutro sítio.
# DATABASE_URL="file:./dados/rmvm.db"

# Autenticação JWT
# Gere um segredo próprio com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-este-segredo-em-producao"
JWT_EXPIRES_IN="7d"

# Administrador criado automaticamente no primeiro arranque.
ADMIN_NAME="Administrador RMVM"
ADMIN_EMAIL="admin@rmvm.com"
ADMIN_PASSWORD="admin123"
